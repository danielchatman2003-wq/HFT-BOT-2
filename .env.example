# Copy to .env and fill in. Never commit .env or *.pem (gitignored).

# --- Kalshi API credentials (required even for paper mode: the market-data
#     websocket needs an authenticated connection; keys are free) ---
# Create at kalshi.com (or demo.kalshi.co for the sandbox): Account -> API keys.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# demo = Kalshi sandbox (fake money, real market structure). prod = real money.
KALSHI_ENV=demo

# paper = real market data, simulated fills, nothing ever sent. SAFE DEFAULT.
# live  = real orders on KALSHI_ENV.
MODE=paper

# Order wire format: "v2" (unified YES-book: side bid/ask, dollar prices,
# /portfolio/events/orders) or "legacy" (/portfolio/orders, yes/no + cents).
# If order placement 4xx's on demo, flip this. See README "Verify before live".
KALSHI_ORDER_API=v2

# --- Market ---
# 15-minute BTC Up/Down series. (ETH equivalent: KXETH15M.)
SERIES_TICKER=KXBTC15M

# --- Fees (dollars formula: ceil_to_cent(rate * count * P * (1-P))) ---
# Kalshi's crypto markets carry a HIGHER multiplier than the general 0.07 and
# makers pay a reduced rate. Check kalshi.com/fee-schedule and set to match.
TAKER_FEE_RATE=0.10
MAKER_FEE_RATE=0.025

# --- BRTI source ---
# auto     -> official CF value streamed by Kalshi's websocket when fresh,
#             local replica as fallback (recommended)
# official -> only the cfbenchmarks_value stream (trading halts if it stalls)
# replica  -> only the local constituent-book estimator
BRTI_SOURCE=auto
# CF Benchmarks index id for the traded series (ETH markets: ETHUSD_RTI)
BRTI_INDEX_ID=BRTI

# --- BRTI replica estimator (CF Real Time Index methodology) ---
BRTI_FEEDS=coinbase,kraken,bitstamp,gemini
BRTI_LAMBDA=10.3
BRTI_DEVIATION_CAP=0.005
BRTI_MIN_DEPTH_BTC=1.0
BRTI_STALE_MS=2500

# Kalshi is migrating no-side orderbook prices to yes-leg pricing. false =
# current server default (no-leg). Flip to true when Kalshi flips the default.
KALSHI_USE_YES_PRICE=false

# --- Volatility ---
VOL_HALF_LIFE_S=300
VOL_MIN_SAMPLES=45
VOL_FLOOR_ANNUAL=0.15
VOL_CAP_ANNUAL=4.0

# --- Strategy ---
ENABLE_TAKER=true
ENABLE_MAKER=true
MIN_TAKER_EDGE_CENTS=3
MIN_MAKER_EDGE_CENTS=1
MAKER_VOL_MULT=1.6
QUOTE_SIZE=10
QUOTE_TTL_S=10
MIN_REPLACE_INTERVAL_MS=400
MAKER_STOP_BEFORE_CLOSE_S=12
TAKER_STOP_BEFORE_CLOSE_S=1.5

# --- Risk ---
BANKROLL_USD=1000
MAX_POS_PER_MARKET=50
MAX_TAKER_SIZE=20
MAX_TOTAL_NOTIONAL_USD=500
MAX_RISK_PER_TRADE=0.02
KELLY_FRACTION=0.25
DAILY_LOSS_LIMIT_USD=100

# --- Rate limits (tokens/sec; Kalshi basic tier defaults) ---
READ_TOKENS_PER_SEC=200
WRITE_TOKENS_PER_SEC=100
TOKENS_PER_REQUEST=10

LOG_LEVEL=INFO
