# Copy this file to .env and fill in your real values. Never commit .env.

# --- Kalshi API credentials ---
# Create an API key at https://kalshi.com/account/api  (or demo.kalshi.co for the demo env)
# This downloads a private key file (PEM). Point KALSHI_PRIVATE_KEY_PATH at it.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# "demo" talks to Kalshi's sandbox (fake money, real market structure) -- use this until you trust the bot.
# "prod" talks to the real exchange with real money.
KALSHI_ENV=demo

# --- Bot mode ---
# paper    -> uses real Kalshi market data but simulates fills locally. No orders are ever sent. SAFE DEFAULT.
# live     -> sends real orders to Kalshi (respects KALSHI_ENV above).
# backtest -> runs src/backtest.py against historical price data, no network calls.
MODE=paper

# --- Risk parameters ---
BANKROLL_USD=1000
MAX_RISK_PER_TRADE=0.02
MAX_CONCURRENT_POSITIONS=3
DAILY_LOSS_LIMIT_USD=100
KELLY_FRACTION=0.25
MIN_EDGE_CENTS=4

# --- Market data ---
BTC_SERIES_TICKER=KXBTCD
COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com
